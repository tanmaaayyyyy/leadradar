      "id": "efc1cc35-8f69-41e3-ad29-41fe571324fc",
      "name": "Gemini Personalization",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2032,
        96
      ]
    },
    {
      "parameters": {
        "jsCode": "let aiOutput = {};\n\ntry {\n  let rawContent =\n    $json.candidates?.[0]?.content?.parts?.[0]?.text || '{}';\n\n  rawContent = rawContent\n    .replace(/```json/gi, '')\n    .replace(/```/g, '')\n    .trim();\n\n  const jsonMatch = rawContent.match(/\\{[\\s\\S]*\\}/);\n\n  if (jsonMatch) {\n    aiOutput = JSON.parse(jsonMatch[0]);\n  }\n} catch (e) {\n  console.log('Parse error:', e);\n}\n\nreturn [\n  {\n    json: {\n      place_id: $json.place_id || '',\n      business_name: $json.business_name || '',\n\n      contact_name: $json.contact_name || '',\n      contact_role: $json.contact_role || '',\n      contact_email: $json.contact_email || '',\n      linkedin_url: $json.linkedin_url || '',\n\n      confidence_score: $json.hunter_confidence || 0,\n\n      personalized_subject: aiOutput.subject_line || '',\n      personalized_observation: aiOutput.observation || '',\n      personalized_email: aiOutput.email_body || '',\n\n      outreach_status: 'outreach_ready',\n      status: 'outreach_ready',\n\n      enriched_at: new Date().toISOString()\n    }\n  }\n];"
      },
