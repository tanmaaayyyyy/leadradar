      "id": "cb176a55-ab84-419a-bef1-af19bb3d7688",
      "name": "Firecrawl Website Scrape",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1600,
        96
      ]
    },
    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nconst lead = staticData.currentEnrichLead || {};\nconst contact = staticData.contactInfo || {};\n\n// Clean website content\nlet websiteContent = ($json.data && $json.data.markdown) ? $json.data.markdown : '';\nwebsiteContent = websiteContent\n  .replace(/!\\[.*?\\]\\(.*?\\)/g, '')\n  .replace(/\\[([^\\]]*)\\]\\([^)]*\\)/g, '$1')\n  .replace(/[\\\\*_`#>]/g, '')\n  .replace(/\\n{3,}/g, '\\n\\n')\n  .trim()\n  .substring(0, 1200);\n\n// Parse opportunities\nlet opportunities = [];\ntry { opportunities = JSON.parse(lead.automation_opportunities || '[]'); } catch(e) {}\nconst oppList = opportunities.length > 0\n  ? opportunities.slice(0, 3).map(o => `- ${o.issue}: ${o.solution}`).join('\\n')\n  : `- ${lead.recommended_solution || 'Process automation and customer workflow'}`;\n\nconst firstName = contact.contact_name\n  ? contact.contact_name.split(' ')[0]\n  : '';\n\nconst systemPrompt = `You are a senior cold outreach copywriter for an AI automation consultancy targeting Indian SMBs.\n\nYour job: write one short, highly personalized cold email that sounds like it was written by a real person who actually looked at this business.\n\nStrict rules:\n- Email body must be under 130 words\n- Reference ONE specific thing you actually observed about their business (from the website content or business data)\n- Name ONE specific pain point with a realistic example of how it hurts them\n- Propose ONE concrete solution (not vague \"AI automation\")\n- End with a soft CTA: ask if they are open to a 10-minute call\n- Subject line: under 8 words, no spam words, no mention of AI or automation\n- No buzzwords: no leverage, streamline, revolutionize, cutting-edge, game-changer\n- Sound human. Not like a marketing template.\n\nReturn ONLY valid JSON:\n{\n  \"subject_line\": \"string\",\n  \"observation\": \"one specific thing noticed about this business\",\n  \"email_body\": \"complete email text starting with greeting\"\n}`;\n\nconst userContent = `Write a cold email for this business:\n\nBusiness: ${lead.business_name}\nType: ${lead.category}\nLocation: ${lead.area}, ${lead.city}\nRating: ${lead.rating}/5 with ${lead.reviews} Google reviews\nWebsite: ${lead.website}\nPhone: ${lead.phone}\n\nContact Person: ${contact.contact_name || 'the owner/decision maker'}\nRole: ${contact.contact_role || 'Business Owner'}\n\nIdentified Pain Points:\n${lead.pain_points || 'Manual customer handling, no digital automation'}\n\nTop Automation Opportunities:\n${oppList}\n\nBest Offer To Pitch:\n${lead.best_offer || lead.recommended_solution || 'AI workflow automation for customer interactions'}\n\nOutreach Angle (use as inspiration, do NOT copy-paste):\n${lead.outreach_angle || 'Help reduce manual workload and improve response time'}\n\nWhat we actually see on their website:\n${websiteContent || 'No website content available'}\n\nStart the email with: Hi ${firstName || 'there'},\nSender name: Tanmay\nOur agency helps Indian SMBs with lightweight AI automations for customer interactions, bookings, and follow-ups.`;\n\nreturn [{\n  json: {\n    request_body: {\n      contents: [{\n        parts: [{\n          text: `${systemPrompt}\\n\\n${userContent}\\n\\nIMPORTANT: Return ONLY valid JSON. No markdown. No explanation outside the JSON.`\n        }]\n      }],\n      generationConfig: {\n        temperature: 0.75,\n        maxOutputTokens: 1500,\n        responseMimeType: 'application/json',\n        thinkingConfig: { thinkingBudget: 0 }\n      }\n    }\n  }\n}];"
      },
      "id": "1d9b6844-300d-4612-a4c5-d38ff9cd6b64",
