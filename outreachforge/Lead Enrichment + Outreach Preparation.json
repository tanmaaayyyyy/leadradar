      },
      "id": "e56aeb97-4fa7-4cc5-a07c-156439d2e7cd",
      "name": "Loop Through Leads",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        672,
        80
      ]
    },
    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nconst lead = items[0].json;\n\nlet domain = '';\ntry {\n  domain = new URL(lead.website).hostname.replace(/^www\\./, '');\n} catch(e) {\n  domain = (lead.website || '')\n    .replace(/^https?:\\/\\/(www\\.)?/, '')\n    .split('/')[0]\n    .split('?')[0];\n}\n\nstaticData.currentEnrichLead = {\n  place_id: lead.place_id || '',\n  business_name: lead.business_name || '',\n  website: lead.website || '',\n  domain: domain,\n  rating: lead.rating || 0,\n  reviews: lead.reviews || 0,\n  phone: lead.phone || '',\n  address: lead.address || '',\n  category: lead.category || '',\n  keyword: lead.keyword || '',\n  niche: lead.niche || '',\n  city: lead.city || '',\n  area: lead.area || '',\n  pain_points: lead.pain_points || '',\n  automation_opportunities: lead.automation_opportunities || '[]',\n  outreach_angle: lead.outreach_angle || '',\n  ai_summary: lead.ai_summary || '',\n  best_offer: lead.best_offer || '',\n  recommended_solution: lead.recommended_solution || '',\n  lead_score: Number(lead.lead_score || 0),\n  automation_score: Number(lead.automation_score || 0)\n};\n\nreturn [{ json: { ...lead, extracted_domain: domain } }];"
      },
      "id": "36139d63-aa8d-4da8-a828-e95d53b387b2",
      "name": "Store Lead Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        96
      ]
    },
    {
      "parameters": {
        "jsCode": "const contacts = $json.contacts || [];\n\ncontacts.sort((a, b) => \n  (b.confidence_score || 0) - (a.confidence_score || 0)\n);\n\nconst best = contacts[0] || {};\n\nreturn [\n  {\n    json: {\n      website: $json.website || '',\n      extracted_domain: $json.extracted_domain || '',\n\n      contact_name: best.contact_name || '',\n      contact_role: best.contact_role || '',\n      contact_email: best.contact_email || '',\n\n      hunter_confidence: best.confidence_score || 0,\n\n      linkedin_url: best.linkedin_url || '',\n\n      emails_found: contacts.length\n    }\n  }\n];"
      },
      "id": "9722b59c-e11c-448c-bfcb-7ec41181da18",
      "name": "Extract Best Contact",
