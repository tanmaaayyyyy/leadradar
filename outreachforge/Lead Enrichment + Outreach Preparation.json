    {
      "parameters": {
        "jsCode": "return items.filter(item => {\n  const lead = item.json;\n  const leadScore = Number(lead.lead_score || 0);\n  const automationScore = Number(lead.automation_score || 0);\n  const status = String(lead.status || '').toLowerCase().trim();\n  const contacted = String(lead.contacted || '').toLowerCase().trim();\n  const hasEmailDraft = lead.personalized_email && String(lead.personalized_email).length > 10;\n\n  return (\n    leadScore > 60 &&\n    automationScore > 20 &&\n    (status === 'new' || status === '') &&\n    contacted !== 'yes' &&\n    !hasEmailDraft &&\n    lead.website &&\n    !String(lead.website).includes('instagram.com') &&\n    !String(lead.website).includes('facebook.com') &&\n    !String(lead.website).includes('zomato.com') &&\n    !String(lead.website).includes('swiggy.com')\n  );\n});"
      },
      "id": "aadba5f8-a913-424a-b3c6-c24a4f48ebb6",
      "name": "Filter High-Quality Leads",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
